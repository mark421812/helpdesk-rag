# Host-only settings for scripts/chat_e2e_test.py.
# This file is never injected into chat-api or migrate. Copy to .env.e2e and
# keep the real service key out of shell history, source control, and logs.
CHAT_E2E_ALLOW_KIS_WRITES=0
CHAT_E2E_KIS_BASE_URL=http://127.0.0.1:8080
CHAT_E2E_KIS_API_KEY=
CHAT_E2E_LOCK_TIMEOUT_SECONDS=60
CHAT_E2E_CHAT_BASE_URL=http://127.0.0.1:8120
CHAT_E2E_USER_ID=chat-e2e-user
CHAT_E2E_GROUP_IDS=all-employees
CHAT_E2E_JOB_TIMEOUT_SECONDS=600
CHAT_E2E_TURN_TIMEOUT_SECONDS=180
