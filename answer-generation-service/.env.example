APP_ENV=development
LOG_LEVEL=INFO
API_INTERNAL_KEY=local-development-only
HELPDESK_NETWORK=helpdesk-rag
ANSWER_GENERATION_BIND_ADDRESS=127.0.0.1

# Offline default for local development and CI.
LLM_PROVIDER=fake
LLM_PROVIDER_USAGE_MODE=test
EXTERNAL_LLM_APPROVED=false
LLM_MODEL=fake-grounded-v1
MAX_GENERATION_CONCURRENCY=2
MAX_GENERATION_QUEUE_SIZE=8
LLM_QUEUE_WAIT_TIMEOUT_SECONDS=10

# NVIDIA Trial: development/test + synthetic/public/non-confidential data only.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
PROVIDER_ALLOWED_HOSTS=["integrate.api.nvidia.com"]

# Groq: to enable it, also set LLM_PROVIDER=groq_hosted,
# LLM_PROVIDER_USAGE_MODE=trial, EXTERNAL_LLM_APPROVED=true, and an available LLM_MODEL.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_ALLOWED_HOSTS=["api.groq.com"]

LLM_MAX_OUTPUT_TOKENS=1024
LLM_TOTAL_TIMEOUT_SECONDS=75
LLM_MAX_RESPONSE_BYTES=262144
MAX_CONTEXT_TOKENS=3000
MAX_PROMPT_TOKENS=12000
GENERATION_TEMPERATURE=0

ATTESTATION_PUBLIC_KEY_PATHS={"retrieval-dev-001":"/run/secrets/retrieval-attestation-public.pem"}
ATTESTATION_ACCEPTED_POLICY_VERSIONS=["retrieval-policy-v1"]
ATTESTATION_POLICY_PROMPT_BINDINGS={"retrieval-policy-v1":["grounded-answer-v1"]}
