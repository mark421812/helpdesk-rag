APP_ENV=development
LOG_LEVEL=INFO
# Published Docker Compose host port; the container listens on 8080.
API_PORT=8080
HELPDESK_NETWORK=helpdesk-rag
# Production must set a long random value. Blank disables internal API authentication.
API_INTERNAL_KEY=

DATABASE_URL=postgresql+asyncpg://knowledge:knowledge@postgres:5432/knowledge
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

QDRANT_URL=http://qdrant:6333
# Replace with a long random secret outside local development.
QDRANT_API_KEY=local-development-only
QDRANT_COLLECTION=helpdesk_knowledge
QDRANT_VECTORS_ON_DISK=true
QDRANT_HNSW_ON_DISK=true
QDRANT_PAYLOAD_ON_DISK=true

MODEL_ID=intfloat/multilingual-e5-small
MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
MODEL_DEVICE=cpu
MODEL_BATCH_SIZE=16
MODEL_MAX_SEQUENCE_LENGTH=512
NORMALIZE_EMBEDDINGS=true
TORCH_NUM_THREADS=2
EMBEDDING_MAX_CONCURRENCY=1

MAX_EMBEDDING_TEXTS=64
MAX_CHARACTERS_PER_TEXT=20000
MAX_SEARCH_LIMIT=50
MAX_SEARCH_CANDIDATES=500
MAX_DOCUMENT_CHUNKS=10000
MAX_DOCUMENT_CHARACTERS=20000000
MAX_REQUEST_BODY_BYTES=25000000

WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=3600
WORKER_RETRY_BASE_SECONDS=5

# JSON array, for example: ["http://localhost:3000"]
CORS_ORIGINS=[]
BUSINESS_TIMEZONE=Asia/Taipei
