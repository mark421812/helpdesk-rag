APP_ENV=development
LOG_LEVEL=INFO
API_INTERNAL_KEY=
HELPDESK_NETWORK=helpdesk-rag

# These compose values build DATABASE_URL. Set DATABASE_URL itself only when
# overriding the complete SQLAlchemy URL.
# DATABASE_URL=postgresql+asyncpg://ingestor:change-me@postgres:5432/knowledge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=knowledge
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

KNOWLEDGE_INDEX_URL=http://knowledge-index-api:8080
KNOWLEDGE_INDEX_API_KEY=
KNOWLEDGE_INDEX_TIMEOUT_SECONDS=120
KNOWLEDGE_INDEX_READINESS_TIMEOUT_SECONDS=5
KNOWLEDGE_INDEX_MAX_REQUEST_BODY_BYTES=25000000
API_MAX_REQUEST_BODY_BYTES=65536

# Containers always read /data/documents. This configures the mounted host path;
# prefer an absolute production path such as /srv/helpdesk/documents.
DOCUMENT_ROOT_HOST=./documents
DEFAULT_SOURCE_NAME=local-documents
ALLOWED_EXTENSIONS=[".pdf",".docx",".txt",".md"]
MAX_FILE_SIZE_BYTES=104857600
MISSING_SCANS_BEFORE_DELETE=2
MAX_MISSING_RATIO=0.25

MODEL_ID=intfloat/multilingual-e5-small
MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
CHUNK_TARGET_TOKENS=350
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_TOKENS=50
MODEL_MAX_SEQUENCE_LENGTH=512
MAX_DOCUMENT_CHARACTERS=20000000
MAX_DOCUMENT_CHUNKS=10000

WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=3600
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BASE_SECONDS=5
ROLE_HEARTBEAT_INTERVAL_SECONDS=10
ROLE_HEARTBEAT_MAX_AGE_SECONDS=60
SCHEDULE_HOUR=2
SCHEDULE_MINUTE=0
SCHEDULE_TIMEZONE=Asia/Taipei

# JSON object. Required metadata may be placed here, in .ingestion.yaml,
# or in a per-file <filename>.metadata.yaml sidecar.
SOURCE_DEFAULT_METADATA={}
CORS_ORIGINS=[]
