APP_ENV=development
LOG_LEVEL=INFO
API_INTERNAL_KEY=local-development-only
HELPDESK_NETWORK=helpdesk-rag
RETRIEVAL_BIND_ADDRESS=127.0.0.1

# Development-only identity adapter. Production refuses to start with this mode.
IDENTITY_MODE=development_headers

KNOWLEDGE_INDEX_URL=http://knowledge-index-api:8080
# Must equal knowledge-index-service API_INTERNAL_KEY. Blank is local-development only.
KNOWLEDGE_INDEX_API_KEY=
KNOWLEDGE_INDEX_CONNECT_TIMEOUT_SECONDS=3
KNOWLEDGE_INDEX_READ_TIMEOUT_SECONDS=45
KNOWLEDGE_INDEX_TOTAL_TIMEOUT_SECONDS=50
KNOWLEDGE_INDEX_READINESS_TIMEOUT_SECONDS=5
KNOWLEDGE_INDEX_MAX_RESPONSE_BODY_BYTES=5000000
KNOWLEDGE_INDEX_RETRY_ATTEMPTS=1
KNOWLEDGE_INDEX_RETRY_BACKOFF_SECONDS=0.2
KNOWLEDGE_INDEX_RETRY_MAX_BACKOFF_SECONDS=2

API_MAX_REQUEST_BODY_BYTES=65536
DEFAULT_RETRIEVAL_LIMIT=8
MAX_RETRIEVAL_LIMIT=20
MAX_CANDIDATE_LIMIT=50
CANDIDATE_MULTIPLIER=3
MAX_CONTEXT_TOKENS=3000
MAX_CHUNKS_PER_DOCUMENT=3
# SCORE_THRESHOLD is intentionally blank until calibrated with company questions.
SCORE_THRESHOLD=

# Development Ed25519 signing key. Run `make keys-dev` before Docker startup.
ATTESTATION_KEY_ID=retrieval-dev-001
ATTESTATION_TTL_SECONDS=120
ATTESTATION_POLICY_VERSION=retrieval-policy-v1

CORS_ORIGINS=[]
